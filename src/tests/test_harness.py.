from datetime import datetime, timedelta

import pytest

from src.task_analyzer import analyze_tasks, TaskValidationError


def criar_tarefa(
    status: str,
    prioridade: str,
    inicio: datetime,
    duracao_horas: int = 0,
    prazo: datetime | None = None,
) -> dict:
    tarefa = {
        "status": status,
        "prioridade": prioridade,
        "data_criacao": inicio,
        "data_conclusao": (
            inicio + timedelta(hours=duracao_horas)
            if status == "concluida"
            else None
        ),
        "data_prazo": prazo,
    }
    return tarefa


def test_cenario_1_calcula_indicadores() -> None:
    inicio = datetime(2026, 1, 1, 8, 0)

    tarefas = [
        criar_tarefa(
            "concluida", "alta", inicio, 4,
            inicio + timedelta(hours=3),
        ),
        criar_tarefa(
            "concluida", "baixa", inicio, 2,
            inicio + timedelta(hours=3),
        ),
        criar_tarefa("pendente", "alta", inicio),
    ]

    resultado = analyze_tasks(tarefas)

    assert resultado["total_tarefas"] == 3
    assert resultado["total_concluidas"] == 2
    assert resultado["total_pendentes"] == 1
    assert resultado["tempo_medio_conclusao_horas"] == 3.0
    assert resultado["tempo_medio_por_prioridade"] == {
        "alta": 4.0,
        "baixa": 2.0,
    }
    assert resultado["taxa_atraso_percentual"] == 50.0


def test_cenario_2_rejeita_datas_inconsistentes() -> None:
    inicio = datetime(2026, 1, 2, 10, 0)

    tarefa = criar_tarefa(
        "concluida",
        "alta",
        inicio,
        duracao_horas=-2,
    )

    with pytest.raises(TaskValidationError):
        analyze_tasks([tarefa])


def test_lista_vazia_retorna_zeros() -> None:
    resultado = analyze_tasks([])

    assert resultado["total_tarefas"] == 0
    assert resultado["total_concluidas"] == 0
    assert resultado["total_pendentes"] == 0
    assert resultado["tempo_medio_conclusao_horas"] == 0.0
    assert resultado["tempo_medio_por_prioridade"] == {}
    assert resultado["taxa_atraso_percentual"] == 0.0


def test_apenas_tarefas_pendentes() -> None:
    inicio = datetime(2026, 1, 1, 8, 0)

    tarefas = [
        criar_tarefa("pendente", "alta", inicio),
        criar_tarefa("pendente", "baixa", inicio),
    ]

    resultado = analyze_tasks(tarefas)

    assert resultado["total_tarefas"] == 2
    assert resultado["total_concluidas"] == 0
    assert resultado["total_pendentes"] == 2
    assert resultado["tempo_medio_conclusao_horas"] == 0.0
    assert resultado["taxa_atraso_percentual"] == 0.0
